---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = await getTagList();
const sortedTags = [...tags].sort(
	(a, b) => b.count - a.count || a.name.localeCompare(b.name),
);

// 计算标签颜色深度 0~1：数量越多颜色越深
const maxCount = Math.max(...tags.map((t) => t.count), 1);
const minCount = Math.min(...tags.map((t) => t.count), 1);
const getDepth = (count: number) => {
	if (maxCount === minCount) return 0.5;
	return (count - minCount) / (maxCount - minCount);
};
const getTagScale = (count: number) => {
	if (maxCount === minCount) return 1;
	const minRem = 0.86;
	const maxRem = 1.48;
	const depth = getDepth(count);
	return Number((minRem + depth * (maxRem - minRem)).toFixed(3));
};
const getTagStyle = (count: number) => {
	const depth = getDepth(count);
	return [
		`--tag-depth: ${depth}`,
		`--tag-scale: ${getTagScale(count)}rem`,
	].join("; ");
};
const isHotTag = (count: number) => count >= maxCount * 0.7;

// Top 10 标签排行
const topTags = sortedTags.slice(0, 10);
const topMaxCount = topTags.length > 0 ? topTags[0].count : 1;
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
    <!-- 页面标题 -->
    <div class="card-base px-8 py-6 mb-4">
        <div class="text-2xl font-bold text-(--primary) mb-2">
            {i18n(I18nKey.tags)}
        </div>
        <p class="text-30 text-sm">
            {i18n(I18nKey.allTags)} · {tags.length} {i18n(I18nKey.tagsCount)}
        </p>
    </div>

    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="flex flex-wrap items-center content-center gap-2.5">
                {sortedTags.map((t) => (
                    <a href={getTagUrl(t.name)}
                       class:list={[
                           "tag-cloud-item group inline-flex items-center",
                           "transition-all duration-200",
                           "hover:scale-105 hover:shadow-md",
                           { "tag-cloud-item-hot": isHotTag(t.count) },
                       ]}
                       style={getTagStyle(t.count)}
                    >
                        <span class="font-medium">
                            <span class="opacity-50">#</span>{t.name.trim()}
                        </span>
                        <span class="tag-cloud-count font-bold text-center">
                            {t.count}
                        </span>
                    </a>
                ))}
            </div>
        </div>
    </div>

    <!-- 空状态 -->
    {
        tags.length === 0 && (
            <div class="card-base px-8 py-12 text-center">
                <Icon is:inline
                    name="material-symbols:tag-off"
                    class="text-5xl text-30 mx-auto mb-4"
                />
                <p class="text-30">{i18n(I18nKey.noData)}</p>
            </div>
        )
    }

    <!-- Top 10 标签排行 -->
    {topTags.length > 0 && (
        <div class="card-base px-8 py-6 mt-4">
            <h2 class="text-lg font-bold text-75 mb-4">
                Top 10
            </h2>
            <div class="flex flex-col gap-3">
                {topTags.map((t, i) => (
                    <a href={getTagUrl(t.name)}
                       class="flex items-center gap-3 group hover:bg-(--btn-card-bg-hover) rounded-lg px-3 py-2 -mx-3 transition-colors"
                    >
                        <span class="text-sm font-bold text-(--primary) w-5 text-right shrink-0">
                            {i + 1}
                        </span>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm font-medium text-50 truncate group-hover:text-(--primary) transition-colors">
                                    #{t.name.trim()}
                                </span>
                                <span class="text-xs text-(--primary) ml-2 shrink-0">
                                    {t.count} {i18n(I18nKey.postsCount)}
                                </span>
                            </div>
                            <div class="h-2 rounded-full bg-(--primary)/10 overflow-hidden">
                                <div
                                    class="h-full rounded-full bg-(--primary) transition-all duration-500"
                                    style={`width: ${(t.count / topMaxCount) * 100}%`}
                                />
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    )}
</MainGridLayout>

<style>
  .tag-cloud-item {
    font-size: var(--tag-scale, 1rem);
    gap: 0.45em;
    padding: 0.45em 0.9em;
    border-radius: 0.9em;
    font-weight: 700;
    line-height: 1;
    transform-origin: center;
    background: color-mix(in oklch, var(--primary) calc(var(--tag-depth) * 10% + 2%), transparent);
    color: color-mix(in oklch, var(--primary) calc(var(--tag-depth) * 45% + 35%), var(--content-meta));
    border: 1px solid color-mix(in oklch, var(--primary) calc(var(--tag-depth) * 22% + 8%), var(--line-divider));
  }

  .tag-cloud-item:hover {
    background: color-mix(in oklch, var(--primary) calc(var(--tag-depth) * 18% + 8%), transparent);
  }

  .tag-cloud-item-hot {
    background: color-mix(in oklch, var(--primary) calc(var(--tag-depth) * 14% + 7%), transparent);
    border-color: color-mix(in oklch, var(--primary) 42%, var(--line-divider));
    box-shadow: 0 10px 28px color-mix(in oklch, var(--primary) 18%, transparent);
  }

  .tag-cloud-item-hot:hover {
    background: color-mix(in oklch, var(--primary) calc(var(--tag-depth) * 26% + 14%), transparent);
  }

  .tag-cloud-count {
    min-width: 1.05em;
    padding-inline: 0.12em;
    font-size: 0.68em;
    line-height: 1;
    color: color-mix(in oklch, var(--content-meta) 70%, transparent);
  }

  .tag-cloud-item-hot .tag-cloud-count {
    color: color-mix(in oklch, var(--primary) 45%, var(--content-meta));
  }
</style>
