---
const PHI = (1 + Math.sqrt(5)) / 2;

let cx = 560;
let cy = 140;
let cw = 1080;
let ch = 1080 / PHI;
const rectA = { x: cx, y: cy, w: cw, h: ch };
const squares: { x: number; y: number; s: number }[] = [];
let dir = 0;

for (let i = 0; i < 40; i++) {
	const s = Math.min(cw, ch);

	if (dir === 0) {
		if (i < 12) squares.push({ x: cx, y: cy, s });
		cx += s;
		cw -= s;
	} else if (dir === 1) {
		if (i < 12) squares.push({ x: cx, y: cy, s });
		cy += s;
		ch -= s;
	} else if (dir === 2) {
		if (i < 12) squares.push({ x: cx + cw - s, y: cy, s });
		cw -= s;
	} else {
		if (i < 12) squares.push({ x: cx, y: cy + ch - s, s });
		ch -= s;
	}

	dir = (dir + 1) % 4;
}

const pole = { x: cx + cw / 2, y: cy + ch / 2 };

const squarePaths = squares.map(
	(square) =>
		`M ${square.x.toFixed(2)} ${square.y.toFixed(2)} h ${square.s.toFixed(2)} v ${square.s.toFixed(2)} h ${(-square.s).toFixed(2)} Z`,
);

const s0 = squares[0].s;
const diagonals = [
	`M ${rectA.x} ${rectA.y} L ${rectA.x + rectA.w} ${rectA.y + rectA.h}`,
	`M ${rectA.x + rectA.w} ${rectA.y} L ${rectA.x + s0} ${rectA.y + rectA.h}`,
];

const b = Math.log(PHI) / (Math.PI / 2);
const anchor = { x: squares[0].x + squares[0].s, y: squares[0].y };
const r0 = Math.hypot(anchor.x - pole.x, anchor.y - pole.y);
const theta0 = Math.atan2(anchor.y - pole.y, anchor.x - pole.x);
const quarterTurn = Math.PI / 2;
const spiralPoints: string[] = [];

for (let t = -2.5 * quarterTurn; t <= 18 * quarterTurn; t += Math.PI / 60) {
	const r = r0 * Math.exp(-b * t);
	const a = theta0 + t;
	spiralPoints.push(
		`${(pole.x + r * Math.cos(a)).toFixed(2)} ${(pole.y + r * Math.sin(a)).toFixed(2)}`,
	);
}

const spiralPath = `M ${spiralPoints.join(" L ")}`;
---

<div class="golden-spiral-layer" aria-hidden="true">
	<svg
		viewBox="0 0 1600 900"
		preserveAspectRatio="xMidYMid slice"
		xmlns="http://www.w3.org/2000/svg"
	>
		<g
			class="golden-spiral-zoom"
			style={`transform-origin: ${pole.x.toFixed(2)}px ${pole.y.toFixed(2)}px`}
		>
			{
				diagonals.map((diagonal, index) => (
					<path
						class="golden-spiral-diag"
						d={diagonal}
						pathLength="1"
						vector-effect="non-scaling-stroke"
						style={`animation-delay: ${(2.6 + index * 0.3).toFixed(2)}s`}
					/>
				))
			}
			{
				squarePaths.map((path, index) => (
					<path
						class="golden-spiral-rect"
						d={path}
						pathLength="1"
						vector-effect="non-scaling-stroke"
						style={`animation-delay: ${(index * 0.22).toFixed(2)}s`}
					/>
				))
			}
			<path
				class="golden-spiral-path"
				d={spiralPath}
				pathLength="1"
				vector-effect="non-scaling-stroke"
			/>
		</g>
	</svg>
</div>

<style is:global>
	.golden-spiral-layer {
		position: fixed;
		inset: 0;
		z-index: -20;
		display: none;
		pointer-events: none;
		user-select: none;
		opacity: 0.85;
	}

	@media (min-width: 768px) {
		.golden-spiral-layer {
			display: block;
		}
	}

	.golden-spiral-layer svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.golden-spiral-zoom {
		transform-box: view-box;
		animation: golden-spiral-zoom 30s linear 7s infinite;
	}

	.golden-spiral-rect,
	.golden-spiral-diag,
	.golden-spiral-path {
		fill: none;
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	.golden-spiral-rect {
		stroke: rgba(102, 204, 255, 0.4);
		stroke-width: 1.2;
		animation: golden-spiral-draw 900ms cubic-bezier(0.45, 0, 0.3, 1) both;
	}

	.golden-spiral-diag {
		stroke: rgba(102, 204, 255, 0.3);
		stroke-width: 1;
		animation: golden-spiral-draw 1100ms cubic-bezier(0.45, 0, 0.3, 1) both;
	}

	.golden-spiral-path {
		stroke: rgba(102, 204, 255, 0.75);
		stroke-width: 2;
		animation: golden-spiral-draw 3200ms cubic-bezier(0.5, 0, 0.35, 1) 3.4s both;
	}

	html.dark .golden-spiral-rect {
		stroke: rgba(102, 204, 255, 0.3);
	}

	html.dark .golden-spiral-diag {
		stroke: rgba(102, 204, 255, 0.2);
	}

	html.dark .golden-spiral-path {
		stroke: rgba(102, 204, 255, 0.6);
	}

	@keyframes golden-spiral-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes golden-spiral-zoom {
		from {
			transform: scale(1) rotate(0deg);
		}
		to {
			transform: scale(2.618033988749895) rotate(180deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.golden-spiral-zoom,
		.golden-spiral-rect,
		.golden-spiral-diag,
		.golden-spiral-path {
			animation: none !important;
		}

		.golden-spiral-rect,
		.golden-spiral-diag,
		.golden-spiral-path {
			stroke-dashoffset: 0 !important;
		}
	}
</style>
