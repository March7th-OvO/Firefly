---
import { Font } from "astro:assets";
import { fontConfig, fontsList } from "@/config";
import { collectUsedFontCssVars, toPublicPath } from "@/utils/fontHelper";

const allCssVars = fontConfig.enable
	? collectUsedFontCssVars(fontConfig)
	: new Set<string>();

const selectedIds: string[] =
	fontConfig.enable && fontConfig.selected
		? Array.isArray(fontConfig.selected)
			? fontConfig.selected
			: [fontConfig.selected]
		: [];

const SYSTEM_FONT_STACK =
	"system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
const selectedFontVars = selectedIds.filter((value) => value !== "system");
const bodyFontFamily =
	selectedFontVars.length > 0
		? [...selectedFontVars.map((value) => `var(${value})`), SYSTEM_FONT_STACK].join(
				", ",
			)
		: SYSTEM_FONT_STACK;

const fontByCssVar = new Map(fontsList.map((font) => [font.cssVariable, font]));
const fontEntries = Array.from(allCssVars)
	.map((cssVar) => ({
		cssVar,
		font: fontByCssVar.get(cssVar),
	}))
	.filter(
		(entry): entry is { cssVar: string; font: (typeof fontsList)[number] } =>
			Boolean(entry.font),
	);

const astroFontEntries = fontEntries.filter((entry) => entry.font.provider !== "local");
const localFontEntries = fontEntries.filter((entry) => entry.font.provider === "local");
const subsetFontVars = new Set(Object.keys(fontConfig.subsetFonts || {}));

const bannerTitleFontVar = fontConfig.enable ? fontConfig.bannerTitleFont || "" : "";
const bannerTitleAccentFontVar = fontConfig.enable
	? fontConfig.bannerTitleAccentFont || ""
	: "";
const bannerSubtitleFontVar = fontConfig.enable
	? fontConfig.bannerSubtitleFont || ""
	: "";
const navbarTitleFontVar = fontConfig.enable ? fontConfig.navbarTitleFont || "" : "";

const getSourceUrl = (source: string | URL | { url: string | URL }) =>
	typeof source === "string" || source instanceof URL
		? source.toString()
		: source.url.toString();

const getFontMimeType = (source: string) => {
	if (source.startsWith("__SUBSET_FONT_")) return "font/woff2";
	const cleanSource = source.split("?")[0].toLowerCase();
	if (cleanSource.endsWith(".woff2")) return "font/woff2";
	if (cleanSource.endsWith(".woff")) return "font/woff";
	if (cleanSource.endsWith(".otf")) return "font/otf";
	if (cleanSource.endsWith(".eot")) return "application/vnd.ms-fontobject";
	return "font/ttf";
};

const getFontFormat = (source: string) => {
	if (source.startsWith("__SUBSET_FONT_")) return "woff2";
	const cleanSource = source.split("?")[0].toLowerCase();
	if (cleanSource.endsWith(".woff2")) return "woff2";
	if (cleanSource.endsWith(".woff")) return "woff";
	if (cleanSource.endsWith(".otf")) return "opentype";
	if (cleanSource.endsWith(".eot")) return "embedded-opentype";
	return "truetype";
};

const getSubsetFontId = (fontName: string, weight?: string | number) =>
	`${fontName}-${weight || "default"}`.toLowerCase().replace(/\s+/g, "-");

const getVariantSourceValue = (
	cssVar: string,
	fontName: string,
	variant: { weight?: string | number; src: Array<string | URL | { url: string | URL }> },
	source: string | URL | { url: string | URL },
) => {
	const publicPath = toPublicPath(getSourceUrl(source));
	if (!publicPath) return null;

	if (import.meta.env.PROD && subsetFontVars.has(cssVar)) {
		return `__SUBSET_FONT_${getSubsetFontId(fontName, variant.weight)}__`;
	}

	return publicPath;
};

const localFontFacesCss = localFontEntries
	.flatMap(({ cssVar, font }) =>
		font.options?.variants?.map((variant) => {
			const sources = variant.src
				.map((source) =>
					getVariantSourceValue(cssVar, font.name, variant, source),
				)
				.filter((value): value is string => Boolean(value))
				.map((value) => `url("${value}") format("${getFontFormat(value)}")`)
				.join(", ");

			if (!sources) return "";

			return `@font-face {
  font-family: "${font.name}";
  src: ${sources};
  font-display: ${font.display || "swap"};
  ${variant.weight ? `font-weight: ${variant.weight};` : ""}
  ${variant.style ? `font-style: ${variant.style};` : ""}
}`;
		}) || [],
	)
	.filter(Boolean)
	.join("\n");

const localFontVariableCss = localFontEntries
	.map(({ cssVar, font }) => {
		const fallbackList = font.fallbacks?.length ? `, ${font.fallbacks.join(", ")}` : "";
		return `${cssVar}: "${font.name}"${fallbackList};`;
	})
	.join("\n      ");

const localPreloadLinks = localFontEntries.flatMap(({ cssVar, font }) => {
	if (!selectedFontVars.includes(cssVar)) return [];

	return (
		font.options?.variants
			?.map((variant) => {
				const href = getVariantSourceValue(
					cssVar,
					font.name,
					variant,
					variant.src[0],
				);
				if (!href) return null;

				return {
					href,
					type: getFontMimeType(href),
				};
			})
			.filter((value): value is { href: string; type: string } => Boolean(value)) || []
	);
});
---

{astroFontEntries.map(({ cssVar }) => (
	<Font cssVariable={cssVar as any} preload={selectedFontVars.includes(cssVar)} />
))}

{localFontFacesCss && <style set:html={localFontFacesCss}></style>}
{localFontVariableCss && <style set:html={`:root {\n      ${localFontVariableCss}\n    }`}></style>}
{localPreloadLinks.map(({ href, type }) => (
	<link rel="preload" href={href} as="font" type={type} crossorigin />
))}

{fontConfig.enable &&
	(
		bannerTitleFontVar ||
		bannerTitleAccentFontVar ||
		bannerSubtitleFontVar ||
		navbarTitleFontVar ||
		selectedFontVars.length > 0
	) && (
		<style
			set:html={`
    ${bannerTitleFontVar || bannerTitleAccentFontVar || bannerSubtitleFontVar || navbarTitleFontVar ? `:root {
      ${bannerTitleFontVar ? `--font-banner-title: var(${bannerTitleFontVar}, inherit);` : ""}
      ${bannerTitleAccentFontVar ? `--font-banner-title-accent: var(${bannerTitleAccentFontVar}, var(--font-banner-title, inherit));` : ""}
      ${bannerSubtitleFontVar ? `--font-banner-subtitle: var(${bannerSubtitleFontVar}, inherit);` : ""}
      ${navbarTitleFontVar ? `--font-navbar-title: var(${navbarTitleFontVar}, inherit);` : ""}
    }` : ""}

    body {
      font-family: ${bodyFontFamily};
    }
  `}
		/>
	)}

<script>
	if (document.fonts && typeof document.fonts.ready !== "undefined") {
		document.fonts.ready
			.then(() => {
				document.dispatchEvent(new CustomEvent("fontsLoaded"));
			})
			.catch((error) => {
				console.warn("Font loading failed:", error);
			});
	}
</script>
